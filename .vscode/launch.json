{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AquaBook",
            "request": "launch",
            "type": "dart",
            "args": [
                "--debug"
            ]
        },
        {
            "name": "AquaBook (release mode)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--release"
            ]
        },
        {
            "name": "Run BuildRunner",
            "command": "flutter pub run build_runner watch --delete-conflicting-outputs",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Clean install pods ",
            "command": "cd ios && rm -rf Podfile.lock && rm -rf Pods && pod repo update && pod install",
            "request": "launch",
            "type": "node-terminal"
        },
    ]
}