{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MultiBook — Android emulator (local API)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=MULTIBOOK_API_BASE_URL=http://10.0.2.2:8080"
            ]
        },
        {
            "name": "MultiBook — iOS simulator (local API)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=MULTIBOOK_API_BASE_URL=http://localhost:8080"
            ]
        },
        {
            "name": "MultiBook — release mode",
            "request": "launch",
            "type": "dart",
            "args": [
                "--release"
            ]
        },
        {
            "name": "Run BuildRunner",
            "command": "flutter pub run build_runner watch --delete-conflicting-outputs",
            "request": "launch",
            "type": "node-terminal"
        },
        {
            "name": "Clean install pods ",
            "command": "cd ios && rm -rf Podfile.lock && rm -rf Pods && pod repo update && pod install",
            "request": "launch",
            "type": "node-terminal"
        },
    ]
}
