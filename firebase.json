{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "flutter": {
    "platforms": {
      "android": {
        "buildConfigurations": {
          "src/dev": {
            "projectId": "aquabook-dev-cdd4f",
            "appId": "1:113851119343:android:5c46d45b573377c9dd0d1a",
            "fileOutput": "android/app/src/dev/google-services.json"
          }
        }
      },
      "ios": {
        "buildConfigurations": {
          "Debug-dev": {
            "projectId": "aquabook-dev-cdd4f",
            "appId": "1:113851119343:ios:5cb51b2edd42907fdd0d1a",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/Runner/dev/GoogleService-Info.plist"
          },
          "Profile-dev": {
            "projectId": "aquabook-dev-cdd4f",
            "appId": "1:113851119343:ios:5cb51b2edd42907fdd0d1a",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/Runner/dev/GoogleService-Info.plist"
          },
          "Release-dev": {
            "projectId": "aquabook-dev-cdd4f",
            "appId": "1:113851119343:ios:5cb51b2edd42907fdd0d1a",
            "uploadDebugSymbols": false,
            "fileOutput": "ios/Runner/dev/GoogleService-Info.plist"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "multibook",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
