rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.userId == userId
          && request.resource.data.userId == resource.data.userId;
      }

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt']);
      }

      match /recently_viewed/{businessId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.customerId == request.auth.uid
          || resource.data.businessOwnerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.customerId == request.auth.uid
          || resource.data.businessOwnerId == request.auth.uid)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.businessOwnerId == resource.data.businessOwnerId;
    }

    match /booking_drafts/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId
        && (request.method != 'create' || request.resource.data.customerId == request.auth.uid);
    }
    match /appointment_drafts/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId
        && (request.method != 'create' || request.resource.data.customerId == request.auth.uid);
    }
    match /appointments/{appointmentId} {
      allow read: if request.auth != null
        && (resource.data.customerId == request.auth.uid
          || resource.data.businessOwnerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.customerId == request.auth.uid
          || resource.data.businessOwnerId == request.auth.uid)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.businessOwnerId == resource.data.businessOwnerId
        && (
          request.auth.uid == resource.data.businessOwnerId
          || (
            request.auth.uid == resource.data.customerId
            && (
              (request.resource.data.rescheduleCount == resource.data.rescheduleCount
                && request.resource.data.date == resource.data.date
                && request.resource.data.startMinutes == resource.data.startMinutes
                && request.resource.data.endMinutes == resource.data.endMinutes)
              || (resource.data.rescheduleCount == 0
                && request.resource.data.rescheduleCount == 1)
              || (!('rescheduleCount' in resource.data)
                && request.resource.data.rescheduleCount == 1)
            )
          )
        );
    }
    // Stores only availability metadata for a provider's 30-minute slot.
    // No customer data is exposed through this collection.
    match /appointment_slots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && request.resource.data.customerId == getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerId
        && (getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.customerId == request.auth.uid
          || getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.businessOwnerId == request.auth.uid)
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.businessId == request.resource.data.businessId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.providerId == request.resource.data.providerId;
      allow update: if false;
      allow delete: if request.auth != null
        && (resource.data.customerId == request.auth.uid
          || (existsAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
            && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.businessOwnerId == request.auth.uid));
    }
    match /service_availability_blocks/{blockId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.businessOwnerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.businessOwnerId == request.auth.uid;
    }
    match /conversations/{conversationId} {
      // A transaction must first get a conversation document before it can
      // create it. A non-existent document contains no private data, while an
      // existing conversation remains visible only to its two participants.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participantIds);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.customerId
          || request.auth.uid == request.resource.data.businessOwnerId)
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId
          == request.resource.data.businessOwnerId
        && request.resource.data.customerId in request.resource.data.participantIds
        && request.resource.data.businessOwnerId in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.businessOwnerId == resource.data.businessOwnerId;
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
    match /saved_businesses/{userId}/items/{businessId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
